#!/usr/bin/env bash
# opencode-wifi: run opencode with ALL its traffic forced over Wi-Fi,
# while the rest of the PC keeps using ethernet.
set -uo pipefail

WIFI_IF="wlp12s0"
NS="wifins"
VETH_HOST="veth-host"
VETH_NS="veth-ns"
HOST_IP="10.200.0.1"
NS_IP="10.200.0.2"
SUBNET="10.200.0.0/24"
TABLE=200
RUN_USER="${SUDO_USER:-$USER}"
RUN_UID="$(id -u "$RUN_USER")"

die() { echo "opencode-wifi: $*" >&2; read -rp "Press Enter to close..."; exit 1; }

# Run the real binary, not a launcher (launchers return instantly -> early cleanup)
OPENCODE_BIN="$(command -v opencode || true)"
[[ -n "$OPENCODE_BIN" ]] || die "opencode not found in PATH"

# Wi-Fi gateway, needed so we can route the namespace out of Wi-Fi only
WIFI_GW="$(ip -4 route show default dev "$WIFI_IF" | awk '{print $3; exit}')"
[[ -n "$WIFI_GW" ]] || die "no default gateway on $WIFI_IF (is Wi-Fi connected?)"

sudo -v || die "sudo failed"

cleanup() {
  sudo iptables -t nat -D POSTROUTING -s "$SUBNET" -o "$WIFI_IF" -j MASQUERADE 2>/dev/null
  sudo iptables -D FORWARD -i "$VETH_HOST" -o "$WIFI_IF" -j ACCEPT 2>/dev/null
  sudo iptables -D FORWARD -i "$WIFI_IF" -o "$VETH_HOST" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
  sudo ip rule del from "$SUBNET" table "$TABLE" 2>/dev/null
  sudo ip route flush table "$TABLE" 2>/dev/null
  sudo ip link del "$VETH_HOST" 2>/dev/null
  sudo ip netns del "$NS" 2>/dev/null
  return 0
}
# Always clean up: normal exit, Ctrl+C, or closing the terminal
trap 'exit 130' INT TERM HUP
trap cleanup EXIT

# Wipe leftovers from an earlier crashed run (this was the instant-close bug)
cleanup

set -e
# DNS for the namespace
sudo mkdir -p "/etc/netns/$NS"
echo "nameserver 8.8.8.8" | sudo tee "/etc/netns/$NS/resolv.conf" >/dev/null

# Namespace + veth pair
sudo ip netns add "$NS"
sudo ip link add "$VETH_HOST" type veth peer name "$VETH_NS"
sudo ip link set "$VETH_NS" netns "$NS"
sudo ip addr add "$HOST_IP/24" dev "$VETH_HOST"
sudo ip link set "$VETH_HOST" up
sudo ip netns exec "$NS" ip addr add "$NS_IP/24" dev "$VETH_NS"
sudo ip netns exec "$NS" ip link set "$VETH_NS" up
sudo ip netns exec "$NS" ip link set lo up
sudo ip netns exec "$NS" ip route add default via "$HOST_IP"

# Policy routing: anything from the namespace goes out Wi-Fi, never ethernet
sudo ip route add "$SUBNET" dev "$VETH_HOST" table "$TABLE"
sudo ip route add default via "$WIFI_GW" dev "$WIFI_IF" table "$TABLE"
sudo ip rule add from "$SUBNET" table "$TABLE" priority 1000

# Forwarding + NAT (-I puts rules above ufw's chains, which DROP forwards)
sudo sysctl -qw net.ipv4.ip_forward=1
sudo sysctl -qw "net.ipv4.conf.$WIFI_IF.rp_filter=2"
sudo iptables -t nat -I POSTROUTING -s "$SUBNET" -o "$WIFI_IF" -j MASQUERADE
sudo iptables -I FORWARD -i "$VETH_HOST" -o "$WIFI_IF" -j ACCEPT
sudo iptables -I FORWARD -i "$WIFI_IF" -o "$VETH_HOST" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
set +e

# Launch opencode inside the namespace as you, in this terminal
sudo ip netns exec "$NS" sudo -u "$RUN_USER" env \
  HOME="$HOME" PATH="$PATH" TERM="${TERM:-xterm-256color}" \
  COLORTERM="${COLORTERM:-}" LANG="${LANG:-C.UTF-8}" \
  XDG_RUNTIME_DIR="/run/user/$RUN_UID" \
  "$OPENCODE_BIN" "$@"
status=$?

if (( status != 0 )); then
  echo "opencode exited with code $status"
  read -rp "Press Enter to close..."
fi
exit "$status"

# Test it works (run in another terminal while opencode is open):
#   sudo ip netns exec wifins curl -s ifconfig.me   -> Wi-Fi public IP
#   curl -s ifconfig.me                             -> ethernet public IP
# If it still closes, run:  bash -x ~/path/to/opencode-wifi  to see the failing line.
